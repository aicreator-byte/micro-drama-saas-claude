# Micro Drama SaaS — Claude leg: backend environment template.
# Copy to .env (same directory) and fill in real values. NEVER commit
# the real .env — it holds live secrets (e.g. NVIDIA_API_KEY).
# .env is resolved relative to backend/ (see app/core/config.py), so the
# server can be started from any working directory via backend/start.sh.

# Application
APP_NAME=Micro Drama SaaS
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development

# Server (start.sh honours PORT/HOST env vars)
HOST=0.0.0.0
PORT=8000

# Database — SQLite by default; PostgreSQL for production
# Example: DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/micro_drama
DATABASE_URL=sqlite+aiosqlite:///./micro_drama.db
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# Security — CHANGE BOTH in production (the defaults are placeholders)
SECRET_KEY=change-me-to-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI — Nvidia NIM key for the auto-generate LLM (and story engine).
# Get one at https://build.nvidia.com (free tier, no card).
NVIDIA_API_KEY=

# CORS — frontend origin(s), comma-separated in .env (parsed as JSON list by pydantic-settings)
CORS_ORIGINS=["http://localhost:3000"]

# S3-compatible storage for assets
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=micro-drama-assets
S3_REGION=us-east-1

# Google OAuth (optional — browser login works without Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Legacy LLM settings (kept for compatibility; auto-generate uses NVIDIA_API_KEY)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o
LLM_BASE_URL=

# Encryption key for stored Google account tokens/passwords (Fernet).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# File uploads
MAX_UPLOAD_SIZE=104857600
UPLOAD_DIR=./uploads

# Browser profiles for Google Flow login (optional; default backend/data/)
# BROWSER_PROFILES_DIR=
